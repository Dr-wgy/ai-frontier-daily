{# AI 前沿早报 HTML 渲染模板 — bold-navy 主题 #}
{% macro news_item(it) -%}
<h3>{{ it.number }}. {{ it.headline }} {% if it.hot %}{{ it.hot }}{% endif %}</h3>
<blockquote class="tag-block">
<p><span class="tag-label">【垂类标签】</span>： {% if it.vertical_tags %}{% for tag in it.vertical_tags %}#{{ tag }}{% if not loop.last %} {% endif %}{% endfor %}{% else %}无{% endif %}</p>
<p><span class="tag-label">【通用标签】</span>： {% if it.general_tags %}{% for tag in it.general_tags %}#{{ tag }}{% if not loop.last %} {% endif %}{% endfor %}{% else %}无{% endif %}</p>
<p><span class="tag-label">【原文链接】</span>： <a href="{{ it.url }}">{{ it.link_label }}</a></p>
</blockquote>
<p class="content-block">📋 <strong>【概要】</strong>： {{ it.summary }}</p>
<p class="content-block">🌱 <strong>【白话】</strong>： {{ it.plain_explain }}</p>
<p class="content-block">🎯 <strong>【影响】</strong>： {% set imp_list = it.impacts if it.impacts is iterable and it.impacts is not string else [] %}{% if imp_list %}{% for imp in imp_list %}{{ imp }}{% if not loop.last %} / {% endif %}{% endfor %}{% else %}暂无{% endif %}</p>
<hr class="divider"/>
{% endmacro -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 前沿早报</title>
    <style>
        body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;font-size:16px;line-height:1.8;color:#1a1a2e;background:#fff;max-width:720px;margin:0 auto;padding:20px;word-wrap:break-word}
        h1{font-size:26px;font-weight:700;color:#1e3a5f;margin:32px 0 16px;padding-bottom:12px;border-bottom:3px solid #1e3a5f;line-height:1.4}
        h2{font-size:22px;font-weight:700;color:#1e3a5f;margin:28px 0 14px;padding:8px 0 8px 12px;border-left:4px solid #1e3a5f;border-bottom:1px solid #e2e8f0;line-height:1.4}
        h3{font-size:18px;font-weight:600;color:#2c5282;margin:24px 0 12px;line-height:1.4}
        h4{font-size:16px;font-weight:600;color:#1a1a2e;margin:20px 0 10px;line-height:1.4}
        p{font-size:16px;line-height:1.8;color:#1a1a2e;margin:12px 0}
        .content-block{font-size:15px;line-height:1.8;color:#1a1a2e;margin:12px 0}
        strong{font-weight:700;color:#1e3a5f}
        em{font-style:italic;color:#4a5568}
        code{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,Courier,monospace;font-size:14px;background:#f0f4f8;color:#1e3a5f;padding:2px 6px;border-radius:4px}
        pre{background:#1e3a5f;color:#e2e8f0;padding:16px;border-radius:6px;overflow-x:auto;margin:16px 0;line-height:1.6}
        pre code{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,Courier,monospace;font-size:14px;background:none;color:#e2e8f0;padding:0;border-radius:0}
        .tag-block{border-left:2px solid #1e3a5f;background:#f0f4f8;margin:10px 0;padding:2px 10px;border-radius:0 6px 6px 0;color:#2c5282}
        .tag-block p{font-size:13px;line-height:1.5;color:#1a1a2e;margin:6px 0}
        .tag-label{font-weight:700;color:#1e3a5f}
        .ref-num{color:#1e3a5f;font-size:11px}
        ul,ol{padding-left:24px;margin:12px 0}
        li{font-size:14px;line-height:1.8;color:#1a1a2e;margin:6px 0}
        .quick-list{padding-left:0;margin:0;list-style:none}
        .quick-item{display:flex;align-items:flex-start;margin-bottom:4px;color:#1a1a2e}
        .bullet{color:#1e3a5f;margin-right:8px;flex-shrink:0;font-size:18px;line-height:1.4}
        table{width:100%;border-collapse:collapse;margin:16px 0;font-size:15px}
        thead{background:#1e3a5f}
        th{background:#1e3a5f;color:#fff;font-weight:600;padding:10px 14px;text-align:left;border:1px solid #1e3a5f}
        td{padding:10px 14px;border:1px solid #e2e8f0;color:#1a1a2e}
        tr{background:#fff}
        img{max-width:100%;height:auto;display:block;margin:24px auto;border-radius:6px}
        a{color:#2c5282;text-decoration:none;font-weight:500}
        .divider{border:none;border-top:2px solid #e2e8f0;margin:24px 0}
        .footer-meta{border-left:4px solid #1e3a5f;background:#f0f4f8;margin:24px 0 0;padding:12px 16px;border-radius:0 6px 6px 0}
        .footer-meta p{font-size:13px;line-height:1.5;color:#2c5282;margin:4px 0}
    </style>
</head>
<body>
{%- if footer.mode == 'blocks' %}
<h3>🚀 今日速览（一句话版）</h3>
<blockquote class="tag-block">
  <ul class="quick-list">
  {% for row in footer.rows -%}
    <li class="quick-item"><span class="bullet">></span><span>{{ row.abbrev }}： {{ row.lines[0] }}{% for line in row.lines[1:] %}{{ line }}{% endfor %}</span></li>
  {% endfor %}
  </ul>
</blockquote>
{% else -%}
{% for line in footer.fallback_lines -%}
{{ line }}
{% endfor %}
{% endif -%}
<hr class="divider"/>
{%- for section in sections %}
<h2>{{ section.heading }}</h2>{% if section.empty -%}
<p><em>今日暂无相关报道</em></p>
<hr class="divider"/>
{% else -%}
{% for it in section.entries -%}
{{ news_item(it) }}
{% endfor %}
{% endif -%}
{% endfor -%}
{%- if unknown is defined and unknown.entries and unknown.entries|length > 0 %}
<h2>{{ sections|length + 1 }}、其他 · 未分类</h2>
{% for it in unknown.entries -%}
{{ news_item(it) }}
{% endfor %}
{% endif -%}
<div class="footer-meta">
<p><strong>时间：</strong> {{ header.date_str }}</p>
<p><strong>覆盖范围：</strong> {{ header.coverage_line }}</p>
<p><strong>数据来源：</strong> {{ header.sources_str }}</p>
<p><strong>标签：</strong> {{ header.header_tag }}</p>
</div>
</body>
</html>
